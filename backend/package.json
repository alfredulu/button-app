{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "prisma generate",
    "render:start": "prisma db push && bun run index.ts",
    "dev": "bun run --hot index.ts",
    "start": "bun run index.ts",
    "dev:node": "tsx watch run-node.ts",
    "start:node": "tsx run-node.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "studio": "cloud-studio --port 3001 --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "6",
    "tsx": "^4.19.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@better-auth/expo": "^1.5.4",
    "@hono/node-server": "1.12.0",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/client": "6",
    "@supabase/supabase-js": "^2.98.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vibecodeapp/backend-sdk": "^1.0.1",
    "@vibecodeapp/cloud-studio": "^0.2.4",
    "better-auth": "^1.5.4",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "hono": "4.6.0",
    "zod": "4.1.11"
  },
  "prisma": {
    "schema": "schema.prisma"
  }
}
