generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// App-specific models — userId is a Supabase UUID (no local FK to auth.users)
model UserProfile {
  id        String @id @default(cuid())
  userId    String @unique
  plan      String @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  daysUsedThisWeek String   @default("[]")
  weekResetAt      DateTime @default(now())
  stripeCustomerId String?

  googleAccessToken    String?
  googleRefreshToken   String?
  googleTokenExpiresAt DateTime?

  phoneNumber         String?
  smsRemindersEnabled Boolean @default(false)
  verifiedPhone       Boolean @default(false)
  defaultReminderKind String  @default("60") // "15" | "30" | "60" | "120" | "morning"

  username                 String? @unique
  displayName              String?
  accountabilityPartnerId  String?
  expoPushToken            String?

  currentStreak         Int @default(0)
  longestStreak         Int @default(0)
  weeklyScore           Int @default(0)
  scoreWeekStart        String?
  weekPlannedDays       Int     @default(0)
  weekScheduledEvents   Int     @default(0)
  weekPlanningHour      Int?
  weekSameHourDays      Int     @default(0)

  totalVoiceSessions   Int @default(0)
  totalEventsScheduled Int @default(0)

  streakFreezeCredits   Int     @default(0)
  streakFreezeMonthYear String?

  lastPlanningLocalDate String?
  lastPlanningTimeZone  String?

  proBadgeProgressStartedAt DateTime?
  badgePlanningLocalDate    String?
  badgeEligibleStreak       Int     @default(0)

  earlyRiserCount Int @default(0)

  onboardingData Json?

  smsFlagged   Boolean   @default(false)
  smsBlockedAt DateTime?

  /// Apple Sign in "sub" — speeds up server-to-server notification lookup
  appleSubject String? @unique
  /// Hide My Email relay disabled (Apple server notification)
  applePrivateRelayDisabledAt DateTime?
  /// User revoked Sign in with Apple consent (sessions invalidated server-side)
  appleConsentRevokedAt DateTime?

  @@index([userId])
}

model VoiceSession {
  id           String          @id @default(cuid())
  userId       String
  transcript   String
  eventCount   Int
  durationSecs Int
  timeZone     String?
  createdAt    DateTime        @default(now())
  events       CalendarEvent[]

  @@index([userId])
  @@index([userId, createdAt])
}

model CalendarEvent {
  id               String       @id @default(cuid())
  sessionId        String
  session          VoiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  title            String
  eventDate        String
  eventTime        String
  description      String?
  location         String?
  reminderTimeMins Int          @default(60)
  calendarEventId  String?
  addedToCalendar  Boolean      @default(false)
  createdAt        DateTime     @default(now())
  smsReminders     SmsReminder[]

  @@index([userId])
  @@index([userId, createdAt])
}

model PlanningDay {
  id        String   @id @default(cuid())
  userId    String
  localDate String
  timeZone  String
  createdAt DateTime @default(now())

  @@unique([userId, localDate])
  @@index([userId])
}

model SmsReminder {
  id              String          @id @default(cuid())
  userId          String
  calendarEventId String?
  calendarEvent   CalendarEvent?  @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  googleEventId   String?
  title           String
  location        String?
  eventStartAt    DateTime
  timeZone        String
  reminderKind    String
  scheduledFor    DateTime
  messageBody     String
  sent            Boolean         @default(false)
  sentAt          DateTime?
  twilioSid       String?
  deliveryStatus  String?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([sent, scheduledFor])
}

model PhoneVerification {
  id             String   @id @default(cuid())
  userId         String   @unique
  codeHash       String
  codeSalt       String
  verifyAttempts Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
}

model TwilioLog {
  id           String   @id @default(cuid())
  userId       String?
  phoneTo      String
  purpose      String
  success      Boolean
  twilioSid    String?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([phoneTo, createdAt])
}

model Badge {
  id        String   @id @default(cuid())
  userId    String
  badgeType String
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeType])
  @@index([userId])
}

model WeeklyScoreRecord {
  id        String   @id @default(cuid())
  userId    String
  weekStart String
  score     Int
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}
